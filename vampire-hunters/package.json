  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
