 "subs": [
  {
   "from": 132,
   "to": 281,
   "speaker": "vampire",
   "text": "« Quatre petits chasseurs…\ndehors après le couvre-feu ? »",
   "en": "Four little hunters… out past curfew?"
  },
  {
   "from": 290,
   "to": 337,
   "speaker": "luca",
   "text": "« Le couvre-feu, c'est\npour les vivants. »",
   "en": "Curfew's for the living."
  },
  {
   "from": 405,
   "to": 545,
   "speaker": "cara",
   "text": "« Ne bouge pas. Ça ne fait\nmal que pour l'éternité. »",
   "en": "Hold still. This only hurts forever."
  },
  {
   "from": 647,
   "to": 737,
   "speaker": "tara",
   "text": "« Je t'ai manqué ? Moi,\nje ne t'ai pas raté. »",
   "en": "Missed me? I didn't miss you."
  },
  {
   "from": 776,
   "to": 822,
   "speaker": "luca",
   "text": "« Trop lent. »",
   "en": "Too slow."
  },
  {
   "from": 851,
   "to": 938,
   "speaker": "luna",
   "text": "« Chut… fais de beaux\nrêves, mon chéri. »",
   "en": "Shh… sweet dreams, darling."
  },
  {
   "from": 1097,
   "to": 1151,
   "speaker": "cara",
   "text": "« Ça fait quatre ce soir. »",
   "en": "That's four tonight."
  },
  {
   "from": 1152,
   "to": 1195,
   "speaker": "tara",
   "text": "« Alors c'est Luca\nqui paie les verres. »",
   "en": "Then drinks are on Luca."
  },
  {
   "from": 1292,
   "to": 1352,
   "speaker": "luca",
   "text": "« Pourquoi c'est toujours moi ? »",
   "en": "Why is it always me?"
  },
  {
   "from": 1395,
   "to": 1456,
   "speaker": "luna",
   "text": "« Parce que t'as perdu\nle pari, mon cœur. »",
   "en": "Because you lost the bet, babe."
  },
  {
   "from": 1545,
   "to": 1621,
   "speaker": "tara",
   "text": "« Aux morts qui restent morts ! »",
   "en": "To dead things staying dead!"
  },
  {
   "from": 1617,
   "to": 1705,
   "speaker": "all",
   "text": "« Santé ! »",
   "en": "Cheers!"
  },
  {
   "from": 1901,
   "to": 1951,
   "speaker": "cara",
   "text": "« Même heure demain ? »",
   "en": "Same time tomorrow?"
  },
  {
   "from": 2075,
   "to": 2113,
   "speaker": "luna",
   "text": "« Évidemment. »",
   "en": "Obviously."
  }
 ],
